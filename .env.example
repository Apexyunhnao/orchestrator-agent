# 环境变量样例 —— 复制成 .env 再填真实值
#   cp .env.example .env       (Windows: copy .env.example .env)
# .env 已在 .gitignore 里，不会入库；切勿把真实密钥提交进仓库。
#
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── 认证（必填）────────────────────────────────────────────
# 三个服务（orchestrator / customer-service / rag）必须使用**同一个** AUTH_SECRET：
# 编排层签发 JWT，下游各自验签同一枚 token。三种角色的账号见 README。
#
# ⚠️ 未配置时服务会**拒绝启动**（fail-closed，不再回落到固定默认密钥）。
#    本地演示最省事的做法：直接运行 start-demo.bat —— 它会生成一次随机密钥并写入三仓的 .env。
AUTH_SECRET=

# ── 模型服务 ───────────────────────────────────────────────
DEEPSEEK_API_KEY=
